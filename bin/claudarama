#!/bin/sh
# The plugin's `claudarama`: the terminal command, run from this copy of the plugin. uv supplies
# Python and the dependencies, so nothing has to be installed first.
command -v uv >/dev/null || { echo "claudarama needs uv. Install it from https://docs.astral.sh/uv/ and try again." >&2; exit 127; }
exec uv run --quiet --project "$(dirname "$0")/.." claudarama "$@"
